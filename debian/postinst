#!/bin/sh
set -e

PATCH=/usr/share/pve-bcachefs/patch-pve.pl

# A host patched by hand before this package existed keeps its pristine copy
# next to the file itself; move it into our state directory so prerm finds it.
# Releases before the patch series spanned several files used an unflattened
# name for the pristine copy.
migrate_flat_name() {
    old=/var/lib/pve-bcachefs/LXC.pm.orig
    new=/var/lib/pve-bcachefs/PVE_LXC.pm.orig
    if [ -f "$old" ] && [ ! -f "$new" ]; then
        mv "$old" "$new"
    fi
}

migrate_pristine_copy() {
    old=/usr/share/perl5/PVE/LXC.pm.orig
    new=/var/lib/pve-bcachefs/PVE_LXC.pm.orig

    if [ -f "$old" ] && [ ! -f "$new" ]; then
        mkdir -p /var/lib/pve-bcachefs
        mv "$old" "$new"
        echo "pve-bcachefs: moved the pristine PVE/LXC.pm copy to $new"
    fi
}

case "$1" in
    configure | triggered)
        migrate_pristine_copy
        migrate_flat_name
        [ -f "$PATCH" ] || exit 0
        # Not fatal: without the patches a sized rootfs is allocated as a raw
        # image (which works and enforces its own size), and migration of a
        # bcachefs volume is refused by PVE. Report it rather than leaving the
        # package half-configured.
        if ! perl "$PATCH"; then
            echo "pve-bcachefs: could not patch PVE::LXC." >&2
            echo "  Container rootfs volumes with a size will be allocated as raw" >&2
            echo "  images instead of subvolumes until this is resolved. A" >&2
            echo "  pve-container update most likely changed the code the patch" >&2
            echo "  expects." >&2
        fi
        ;;
esac

#DEBHELPER#

exit 0
