#!/bin/sh
set -e

PATCH=/usr/share/pve-bcachefs/patch-pve.pl

case "$1" in
    remove | deconfigure)
        # Reverse only our own change. pve-lxc-snapshot-mount patches the same
        # file for its own reasons, so restoring the pristine copy wholesale
        # would silently revert it too.
        [ -f "$PATCH" ] && perl "$PATCH" --revert || true
        ;;
esac

#DEBHELPER#

exit 0
