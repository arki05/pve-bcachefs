# Configuration for pve-bcachefs.

# Whether to patch /usr/share/perl5/PVE/LXC.pm on install and after every
# pve-container upgrade. The patch allows a container rootfs with a size to be
# placed as a bcachefs subvolume (a folder) instead of ext4 in a raw image, and
# enables snapshot-mode vzdump backups for subvolume containers.
#
# With this set to "no" the storage plugin is installed but pve-container is
# left untouched: sized container rootfs volumes then land as raw images, which
# works and enforces its own size, just without the folder layout.
APPLY_LXC_PATCH=yes
