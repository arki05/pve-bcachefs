# bcachefs: native subvolume snapshots, reflink clones, local (non-shared).
SUPPORTS_SNAPSHOTS=true
# The plugin advertises clone->base for both raw and subvol volumes and
# implements create_base, so a linked clone is a reflink or a subvolume
# snapshot rather than a copy.
SUPPORTS_LINKED_CLONE=true
SUPPORTS_BACKUP=true
SUPPORTS_LXC=true
SUPPORTS_IMAGES=true
SUPPORTS_THIN_PROVISION=true
# A quota-backed container rootfs is a directory on a much larger filesystem.
# The size is enforced, but `df` inside the container reports the filesystem,
# not the project limit - so a resize is real and simply not visible in there.
# The configured size is a real limit, enforced by a project quota.
ENFORCES_VOLUME_SIZE=true
SUPPORTS_TPM=true
SUPPORTS_VMSTATE=true
# bcachefs fsck wants the filesystem offline, so this checks what can be
# checked online: the filesystem is still mounted read-write and reports no
# errors in its own counters.
CONSISTENCY_CHECK=mountpoint -q /mnt/lab-bcachefs && ! grep -q " ro," /proc/mounts
# bcachefs snapshots are independent subvolumes, so rolling back to an older
# one leaves the newer ones in place.
ROLLBACK_PAST_NEWER_SNAPSHOTS=true
VM_RESIZE_VISIBLE_IN_GUEST=true
CT_RESIZE_VISIBLE_IN_GUEST=false
